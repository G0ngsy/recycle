# Local frontend origins only. Add an explicit deployed origin when deploying.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
MAX_IMAGE_BYTES=5242880

# CPU is the safe default. Set true only on a verified CUDA environment.
EASYOCR_GPU=false
EASYOCR_MODEL_DIR=
EASYOCR_DOWNLOAD_ENABLED=true

# Local Ollama is optional. API failures return a safe fallback guide.
USE_OLLAMA=true
OLLAMA_MODEL=exaone3.5
AI_TIMEOUT_SECONDS=20

# Optional remote provider. Never commit a real token.
HF_API_TOKEN=
HF_MODEL=LGAI-EXAONE/EXAONE-3.5-7.8B-Instruct

# Optional and currently not connected to the runtime API flow.
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
